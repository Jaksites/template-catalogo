---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogBook from '../../components/catalogo/CatalogBook.astro';
import CartFloatingBar from '../../components/catalogo/CartFloatingBar.astro';
import FooterMinimal from '../../components/catalogo/Footer.astro';
import { presets } from '../../presets';

// 1. Gera todas as rotas estáticas para os nichos
export async function getStaticPaths() {
  return Object.entries(presets).map(([key, preset]) => ({
    params: { niche: preset.slug.toLowerCase() },
    props: { currentPreset: preset },
  }));
}

// 2. Extrai as propriedades do nicho atual
const { currentPreset } = Astro.props;
const currentConfig = currentPreset.config;
const currentProducts = currentPreset.products;

// Lista de todos os nichos disponíveis para o Seletor/Switcher
const allPresets = Object.values(presets);
---

<BaseLayout config={currentConfig} title={`${currentPreset.name} | Catálogo Digital`}>
  
  

  <!-- LIVRO CENTRAL DO CATÁLOGO: Agora recebe os dados DINÂMICOS do nicho atual -->
  <div class="relative z-10 w-full flex justify-center py-1 sm:py-2">
    <CatalogBook 
      config={currentConfig} 
      banner={currentConfig.banner} 
      products={currentProducts} 
    />
  </div>

  <!-- Rodapé que respeita os dados da loja atual -->
  <FooterMinimal config={currentConfig} />

  <!-- Barra da Sacola do Nicho Atual -->
  <CartFloatingBar config={currentConfig} />

</BaseLayout>

<style>
  /* Esconde a barra de rolagem horizontal nativa mantendo o swipe no celular */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>