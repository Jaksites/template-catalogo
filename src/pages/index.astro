---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogBook from '../components/catalogo/CatalogBook.astro';
import CartFloatingBar from '../components/catalogo/CartFloatingBar.astro';
import FooterMinimal from '../components/catalogo/Footer.astro';
import { siteConfig, products } from '../config/active';


---

<BaseLayout config={siteConfig}>
  <!-- Livro Central -->
  <div class="relative z-10 w-full flex justify-center py-2 sm:py-2">
    <CatalogBook 
      config={siteConfig} 
      banner={siteConfig.banner} 
      products={products} 
    />
  </div>

  <!-- Rodapé que agora rola naturalmente antes do fim da página -->
  <FooterMinimal config={siteConfig} />

  <!-- Barra Fixa Flutuante -->
  <CartFloatingBar config={siteConfig} />
</BaseLayout>