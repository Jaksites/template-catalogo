---
// src/components/catalogo/CatalogCover.astro
import type { SiteConfig } from '../../types';

interface Props {
  config: SiteConfig;
  banner?: SiteConfig['banner'];
  categories: string[];
}

const { config, banner = config.banner, categories } = Astro.props;
const bannerImg = banner?.images?.[0] || config.banner?.images?.[0] || config.logoUrl || '';
---

<div id="book-cover-spread" class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-10 h-full">
  
  <!-- Lado Esquerdo: Capa Revista -->
  <div 
    id="cover-hero-page" 
    class="relative rounded-xl sm:rounded-2xl overflow-hidden p-4 sm:p-8 flex flex-col justify-between h-full border border-[#2D2A26] shadow-md"
    style="background-color: var(--brand-dark, #161514);"
  >
    {bannerImg && (
      <img 
        src={bannerImg} 
        alt={banner?.title || config.name} 
        class="absolute inset-0 w-full h-full object-cover opacity-60 filter brightness-90 contrast-105"
        loading="eager"
      />
    )}
    <div 
      class="absolute inset-0 pointer-events-none"
      style="background: linear-gradient(to top, var(--brand-dark, #121110) 0%, rgba(18, 17, 16, 0.45) 60%, transparent 100%);"
    ></div>

   <!-- Topo da Capa -->
    <div class="relative z-10 flex items-center justify-between">
      <span 
        class="inline-flex items-center gap-1.5 px-2.5 py-0.5 backdrop-blur-md rounded-full text-[8px] sm:text-[9px] uppercase tracking-[0.2em] font-medium border"
        style="background-color: rgba(255, 255, 255, 0.12); color: #FAF8F5; border-color: rgba(255, 255, 255, 0.15);"
      >
        <span>{banner?.badge || 'Destaque'}</span>
      </span>
      
      <span class="text-[8px] sm:text-[9px] font-mono uppercase tracking-[0.3em]" style="color: var(--brand-primary, #C5A880);">
        Nº 01
      </span>
    </div>

    <!-- Conteúdo Inferior da Capa -->
    <div class="relative z-10 text-[#F5F2EB] pt-4">
      <span 
        class="text-[8px] sm:text-[9px] tracking-[0.25em] uppercase block mb-1 font-mono"
        style="color: var(--brand-accent, #E8DEC8);"
      >
        Volume Inaugural
      </span>
      <h2 class="font-serif text-xl sm:text-3xl font-normal tracking-tight leading-tight mb-1.5 text-balance drop-shadow-sm">
        {banner?.title || config.name}
      </h2>
      <p class="text-[11px] sm:text-xs text-[#DDD8CE] line-clamp-2 leading-relaxed font-light mb-3 sm:mb-6">
        {banner?.description || config.tagline}
      </p>

      <button
        id="hero-next-mobile-btn"
        type="button"
        class="sm:hidden w-full py-2.5 bg-[#FAF8F5] text-[#1A1918] font-medium text-[11px] tracking-[0.16em] uppercase rounded-lg flex items-center justify-center gap-1.5 shadow-md cursor-pointer active:scale-[0.98] transition-all"
      >
        <span>Explorar Catálogo</span>
        <span class="font-serif text-xs">→</span>
      </button>
    </div>
  </div>

    <!-- Lado Direito: Sumário Editorial -->
  <div 
    id="cover-index-page" 
    class="bg-[#FCFCFA] rounded-xl sm:rounded-2xl p-4 sm:p-8 flex flex-col justify-between h-full border border-[#EBE8E1] shadow-xs"
  >
    <div class="flex-1 overflow-y-auto no-scrollbar">
      <div class="border-b border-[#ECE8E1] pb-2 mb-2 sm:mb-4">
        <span class="text-[8px] font-mono uppercase tracking-[0.2em] text-[#9E978F]">Index</span>
        <h3 class="font-serif text-lg sm:text-2xl text-[#1A1918] font-normal tracking-tight">Sumário</h3>
      </div>

      <div class="flex flex-col gap-0.5 sm:gap-1.5">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-cover-category={cat === 'Todos' ? 'all' : cat}
            class="flex items-center justify-between p-2 sm:p-2.5 rounded hover:bg-[#F4F1EA] transition-colors text-left text-[#383431] group cursor-pointer border-b border-[#F5F2EC]"
          >
            <span class="font-serif text-xs sm:text-base tracking-wide group-hover:translate-x-1 transition-transform">
              {cat}
            </span>
            <span class="text-[9px] font-mono tracking-widest text-[#B5AEA4] group-hover:text-(--brand-primary)">
              {String(idx + 1).padStart(2, '0')}
            </span>
          </button>
        ))}
      </div>
    </div>

    <div class="pt-2 sm:pt-4 border-t border-[#ECE8E1]">
      <button
        id="cover-start-btn"
        type="button"
        class="w-full py-2.5 sm:py-3.5 text-[#FAF8F5] text-[11px] sm:text-xs font-medium tracking-[0.2em] uppercase rounded-lg transition-all cursor-pointer shadow-sm active:scale-[0.98]"
        style="background-color: var(--brand-dark, #1A1918);"
      >
        <span>Abrir Catálogo</span>
        <span class="font-serif text-xs">→</span>
      </button>
    </div>
  </div>
</div>