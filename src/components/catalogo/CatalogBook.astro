---
import type { Product, ProductVariation, SiteConfig } from '../../types';
import CatalogProductCard from './CatalogProductCard.astro';
import CatalogCover from './CatalogCover.astro';
import CatalogBackCover from './CatalogBackCover.astro';
import CatalogControls from './CatalogControls.astro';

interface Props {
  products: Product[];
  config: SiteConfig;
  banner?: SiteConfig['banner'];
}

const { products, config, banner } = Astro.props;

const normalizedProducts = products.map((product) => {
  const variations: ProductVariation[] = product.variations && product.variations.length > 0
    ? product.variations
    : (product.sizes || []).map(s => ({ name: s, price: product.price, image: product.image }));

  return {
    ...product,
    variations,
    initialVariation: variations[0] || { name: 'Padrão', price: product.price, image: product.image }
  };
});

const categories = ['Todos', ...Array.from(new Set(products.map(p => p.category).filter(Boolean)))];
---

<!-- Importação de Fonte Serifada de Luxo no Cabeçalho do HTML -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

<div id="catalog-book-wrapper" class="w-full max-w-5xl mx-auto px-2 sm:px-4 pt-1 pb-2 sm:pb-4 select-none font-sans">
  
  <!-- Barra Superior Minimalista (mantém igual) -->
  <div class="hidden sm:flex items-center justify-between mb-2 sm:mb-4 px-2">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[#1A1918]"></span>
      <span id="book-mode-badge" class="text-[9px] uppercase tracking-[0.25em] font-medium text-[#857E77] font-mono">
        Catálogo Geral
      </span>
    </div>

    <!-- Navegação Numérica -->
    <div class="flex items-center gap-3">
      <span id="book-page-indicator" class="text-[11px] font-mono tracking-widest text-[#5E5953]">
        Capa
      </span>

      <div class="flex items-center gap-1 bg-[#ECEAE4] p-1 rounded-lg">
        <button id="book-prev-btn" type="button" aria-label="Voltar" class="w-7 h-7 rounded bg-white text-[#1A1918] shadow-xs flex items-center justify-center hover:bg-[#1A1918] hover:text-white transition-colors disabled:opacity-20 cursor-pointer">
          <svg class="w-3.5 h-3.5 stroke-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
        </button>
        <button id="book-next-btn" type="button" aria-label="Avançar" class="w-7 h-7 rounded bg-white text-[#1A1918] shadow-xs flex items-center justify-center hover:bg-[#1A1918] hover:text-white transition-colors disabled:opacity-20 cursor-pointer">
          <svg class="w-3.5 h-3.5 stroke-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- CONTAINER DO LIVRO (Mesa com Textura e Sombra Suave) -->
   <div class="book-container relative bg-[#F7F5F0] rounded-2xl sm:rounded-3xl p-2.5 sm:p-8 shadow-[0_20px_60px_-15px_rgba(20,15,10,0.08)] border border-[#E8E5DD] overflow-hidden flex flex-col justify-center h-[calc(100dvh-200px)] min-h-107.5 max-h-125 sm:h-140 sm:max-h-none">
    
    <!-- Lombada Central (Vinco sutil de folha dobrada) -->
    <div class="hidden sm:block absolute top-0 bottom-0 left-1/2 -translate-x-1/2 w-10 bg-linear-to-r from-transparent via-[#000000]/6 to-transparent pointer-events-none z-20"></div>
    <div class="hidden sm:block absolute top-0 bottom-0 left-1/2 w-px bg-[#E3DFD5] z-20 pointer-events-none"></div>
    <CatalogControls />

    <!-- Palco 3D -->
    <div id="catalog-spread-stage" class="w-full h-full flex flex-col justify-center">
       <CatalogCover 
    config={config} 
    banner={banner || config.banner} 
    categories={categories} 
  />

      <div id="catalog-products-stage" class="hidden grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-10 h-full">
        {normalizedProducts.map((product, index) => (
          <CatalogProductCard product={product} index={index} />
        ))}
<article id="catalog-blank-page" class="hidden flex-col items-center justify-center bg-white/40 rounded-xl sm:rounded-2xl border border-dashed border-[#DFDBD3] text-center p-4 h-full">
          <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-[#A39E96]">Página Final</span>
        </article>
      </div>

      <CatalogBackCover config={config} />
    </div>
  </div>
</div>

<style>
  .font-serif {
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .book-container {
    perspective: 1600px;
  }
  #catalog-spread-stage {
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }
  .anim-flip-next {
    animation: bookFlipNext 0.4s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }
  .anim-flip-prev {
    animation: bookFlipPrev 0.4s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  @keyframes bookFlipNext {
    0% { transform: rotateY(0deg); opacity: 1; }
    50% { transform: rotateY(-25deg) scale(0.98); opacity: 0.7; filter: drop-shadow(-15px 10px 20px rgba(0,0,0,0.12)); }
    100% { transform: rotateY(0deg); opacity: 1; }
  }

  @keyframes bookFlipPrev {
    0% { transform: rotateY(0deg); opacity: 1; }
    50% { transform: rotateY(25deg) scale(0.98); opacity: 0.7; filter: drop-shadow(15px 10px 20px rgba(0,0,0,0.12)); }
    100% { transform: rotateY(0deg); opacity: 1; }
  }
</style>

<script>
  // O seu script de lógica anterior roda 100% compatível aqui sem alterações nos IDs
  import { addToCart } from '../../scripts/cartStore';

  function initCatalogBook() {
    const stage = document.getElementById('catalog-spread-stage');
    const coverSpread = document.getElementById('book-cover-spread');
    const coverHero = document.getElementById('cover-hero-page');
    const coverIndex = document.getElementById('cover-index-page');
    const productsStage = document.getElementById('catalog-products-stage');
    const backcoverSpread = document.getElementById('book-backcover-spread');
    const backContact = document.getElementById('back-contact-page');
    const backCheckout = document.getElementById('back-checkout-page');
    const blankPage = document.getElementById('catalog-blank-page');

    const items = Array.from(document.querySelectorAll<HTMLElement>('.catalog-item'));
    const prevBtn = document.getElementById('book-prev-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('book-next-btn') as HTMLButtonElement | null;
    const dogEarPrev = document.getElementById('dog-ear-prev') as HTMLButtonElement | null;
    const dogEarNext = document.getElementById('dog-ear-next') as HTMLButtonElement | null;
    const pageIndicator = document.getElementById('book-page-indicator');
    const modeBadge = document.getElementById('book-mode-badge');

    if (!stage || items.length === 0) return;

    let currentCategory = 'all';
    let currentSpread = 0;
    let isFlipping = false;

    const isMobile = () => window.innerWidth < 640;

    function getFilteredItems() {
      return items.filter(item => {
        if (currentCategory === 'all') return true;
        return item.dataset.category?.toLowerCase() === currentCategory.toLowerCase();
      });
    }

    function getTotalSpreads() {
      const visibleItems = getFilteredItems();
      return isMobile() ? 2 + visibleItems.length + 2 : 1 + (Math.ceil(visibleItems.length / 2) || 1) + 1;
    }

    function renderBook() {
      const mobile = isMobile();
      const visibleItems = getFilteredItems();
      const totalSpreads = getTotalSpreads();

      if (currentSpread < 0) currentSpread = 0;
      if (currentSpread >= totalSpreads) currentSpread = totalSpreads - 1;

      coverSpread?.classList.add('hidden');
      coverSpread?.classList.remove('grid');
      productsStage?.classList.add('hidden');
      productsStage?.classList.remove('grid');
      backcoverSpread?.classList.add('hidden');
      backcoverSpread?.classList.remove('grid');
      blankPage?.classList.add('hidden');
      blankPage?.classList.remove('flex');
      items.forEach(el => el.classList.add('hidden'));

      coverHero?.classList.remove('hidden');
      coverIndex?.classList.remove('hidden');
      backContact?.classList.remove('hidden');
      backCheckout?.classList.remove('hidden');

      if (mobile) {
        if (currentSpread === 0) {
          coverSpread?.classList.remove('hidden');
          coverSpread?.classList.add('grid');
          coverIndex?.classList.add('hidden');
          if (pageIndicator) pageIndicator.textContent = 'Capa';
          if (modeBadge) modeBadge.textContent = 'Apresentação';
          updateControls(true, false);
          return;
        }

        if (currentSpread === 1) {
          coverSpread?.classList.remove('hidden');
          coverSpread?.classList.add('grid');
          coverHero?.classList.add('hidden');
          if (pageIndicator) pageIndicator.textContent = 'Sumário';
          if (modeBadge) modeBadge.textContent = 'Índice';
          updateControls(false, false);
          return;
        }

        const backContactIndex = 2 + visibleItems.length;
        const backCheckoutIndex = backContactIndex + 1;

        if (currentSpread === backContactIndex) {
          backcoverSpread?.classList.remove('hidden');
          backcoverSpread?.classList.add('grid');
          backCheckout?.classList.add('hidden');
          if (pageIndicator) pageIndicator.textContent = 'Atendimento';
          updateControls(false, false);
          return;
        }

        if (currentSpread === backCheckoutIndex) {
          backcoverSpread?.classList.remove('hidden');
          backcoverSpread?.classList.add('grid');
          backContact?.classList.add('hidden');
          if (pageIndicator) pageIndicator.textContent = 'Garantia';
          updateControls(false, true);
          return;
        }

        productsStage?.classList.remove('hidden');
        productsStage?.classList.add('grid');
        const currentItem = visibleItems[currentSpread - 2];
        if (currentItem) currentItem.classList.remove('hidden');

        if (pageIndicator) {
          pageIndicator.textContent = `Pág. ${String(currentSpread - 1).padStart(2, '0')} / ${String(visibleItems.length).padStart(2, '0')}`;
        }
        updateControls(false, false);
      } else {
        if (currentSpread === 0) {
          coverSpread?.classList.remove('hidden');
          coverSpread?.classList.add('grid');
          if (pageIndicator) pageIndicator.textContent = 'Capa';
          updateControls(true, false);
          return;
        }

        if (currentSpread === totalSpreads - 1) {
          backcoverSpread?.classList.remove('hidden');
          backcoverSpread?.classList.add('grid');
          if (pageIndicator) pageIndicator.textContent = 'Contracapa';
          updateControls(false, true);
          return;
        }

        productsStage?.classList.remove('hidden');
        productsStage?.classList.add('grid');

        const startIndex = (currentSpread - 1) * 2;
        const currentItems = visibleItems.slice(startIndex, startIndex + 2);
        currentItems.forEach(el => el.classList.remove('hidden'));

        if (currentItems.length === 1 && blankPage) {
          blankPage.classList.remove('hidden');
          blankPage.classList.add('flex');
        }

        if (pageIndicator) {
          const p1 = String(startIndex + 1).padStart(2, '0');
          const p2 = String(Math.min(startIndex + 2, visibleItems.length)).padStart(2, '0');
          pageIndicator.textContent = `Pág. ${p1} — ${p2} / ${String(visibleItems.length).padStart(2, '0')}`;
        }
        updateControls(false, false);
      }
    }

    function updateControls(isFirst: boolean, isLast: boolean) {
  if (prevBtn) prevBtn.disabled = isFirst;
  if (nextBtn) nextBtn.disabled = isLast;

  if (dogEarPrev) {
    if (isFirst) {
      dogEarPrev.classList.add('opacity-0', 'pointer-events-none');
      dogEarPrev.classList.remove('opacity-100', 'pointer-events-auto');
    } else {
      dogEarPrev.classList.remove('opacity-0', 'pointer-events-none');
      dogEarPrev.classList.add('opacity-100', 'pointer-events-auto');
    }
  }

  if (dogEarNext) {
    if (isLast) {
      dogEarNext.classList.add('opacity-0', 'pointer-events-none');
      dogEarNext.classList.remove('opacity-100', 'pointer-events-auto');
    } else {
      dogEarNext.classList.remove('opacity-0', 'pointer-events-none');
      dogEarNext.classList.add('opacity-100', 'pointer-events-auto');
    }
  }
}

    function turnPage(delta: number) {
      if (isFlipping) return;
      const targetSpread = currentSpread + delta;
      if (targetSpread < 0 || targetSpread >= getTotalSpreads()) return;

      isFlipping = true;
      const animClass = delta > 0 ? 'anim-flip-next' : 'anim-flip-prev';
      stage?.classList.remove('anim-flip-next', 'anim-flip-prev');
      void stage?.offsetWidth;
      stage?.classList.add(animClass);

      setTimeout(() => {
        currentSpread += delta;
        renderBook();
      }, 180);

      setTimeout(() => {
        stage?.classList.remove(animClass);
        isFlipping = false;
      }, 400);
    }

    prevBtn?.addEventListener('click', () => turnPage(-1));
    nextBtn?.addEventListener('click', () => turnPage(1));
    dogEarPrev?.addEventListener('click', () => turnPage(-1));
    dogEarNext?.addEventListener('click', () => turnPage(1));
    document.getElementById('hero-next-mobile-btn')?.addEventListener('click', () => turnPage(1));

    document.getElementById('cover-start-btn')?.addEventListener('click', () => {
      currentSpread = isMobile() ? 2 : 1;
      renderBook();
    });

    document.getElementById('backcover-restart-btn')?.addEventListener('click', () => {
      currentSpread = 0;
      renderBook();
    });

    document.querySelectorAll('[data-cover-category]').forEach(btn => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-cover-category') || 'all';
        currentSpread = isMobile() ? 2 : 1;
        renderBook();
      });
    });

    stage?.addEventListener('click', (e) => {
  const varBtn = (e.target as HTMLElement).closest('[data-var-btn]') as HTMLButtonElement | null;
  if (!varBtn) return;
  const card = varBtn.closest('.catalog-item') as HTMLElement;
  if (!card) return;

  card.querySelectorAll('[data-var-btn]').forEach(b => {
    (b as HTMLElement).className = 'px-2.5 py-1 text-[11px] font-medium tracking-wide rounded-md border transition-all cursor-pointer truncate max-w-full bg-white text-[#524D48] border-[#DFDBD3] hover:border-[#8C827A]';
    (b as HTMLElement).style.backgroundColor = '';
  });
  
  varBtn.className = 'px-2.5 py-1 text-[11px] font-medium tracking-wide rounded-md border transition-all cursor-pointer truncate max-w-full border-transparent text-white shadow-xs';
  varBtn.style.backgroundColor = 'var(--brand-dark, #1A1918)';

  const price = Number(varBtn.dataset.varPrice);
  const priceEl = card.querySelector('[data-item-price]');
  if (priceEl && !isNaN(price)) priceEl.textContent = `R$ ${price.toFixed(2).replace('.', ',')}`;

  const imgUrl = varBtn.dataset.varImage;
  const imgEl = card.querySelector('[data-item-image]') as HTMLImageElement | null;
  if (imgEl && imgUrl) imgEl.src = imgUrl;

  // Sincroniza com o select do mobile se a tela mudar
  const selectEl = card.querySelector('[data-var-select]') as HTMLSelectElement | null;
  if (selectEl && varBtn.dataset.varIdx) selectEl.value = varBtn.dataset.varIdx;
});

// 2. Alternância via Dropdown Select (Mobile)
stage?.addEventListener('change', (e) => {
  const select = (e.target as HTMLElement).closest('[data-var-select]') as HTMLSelectElement | null;
  if (!select) return;
  const card = select.closest('.catalog-item') as HTMLElement;
  if (!card) return;

  const selectedOption = select.options[select.selectedIndex];
  if (!selectedOption) return;

  const price = Number(selectedOption.dataset.varPrice);
  const priceEl = card.querySelector('[data-item-price]');
  if (priceEl && !isNaN(price)) priceEl.textContent = `R$ ${price.toFixed(2).replace('.', ',')}`;

  const imgUrl = selectedOption.dataset.varImage;
  const imgEl = card.querySelector('[data-item-image]') as HTMLImageElement | null;
  if (imgEl && imgUrl) imgEl.src = imgUrl;

  // Atualiza também os botões de desktop se redimensionar
  const varIdx = select.value;
  const targetBtn = card.querySelector(`[data-var-btn][data-var-idx="${varIdx}"]`) as HTMLButtonElement | null;
  if (targetBtn) {
    card.querySelectorAll('[data-var-btn]').forEach(b => {
      (b as HTMLElement).className = 'px-2.5 py-1 text-[11px] font-medium tracking-wide rounded-md border transition-all cursor-pointer truncate max-w-full bg-white text-[#524D48] border-[#DFDBD3]';
      (b as HTMLElement).style.backgroundColor = '';
    });
    targetBtn.className = 'px-2.5 py-1 text-[11px] font-medium tracking-wide rounded-md border transition-all cursor-pointer truncate max-w-full border-transparent text-white shadow-xs';
    targetBtn.style.backgroundColor = 'var(--brand-dark, #1A1918)';
  }
});

// 3. Adicionar ao Carrinho (Lê tanto do Select quanto do Botão)
stage?.addEventListener('click', (e) => {
  const addBtn = (e.target as HTMLElement).closest('[data-btn-add-cart]') as HTMLButtonElement | null;
  if (!addBtn) return;
  const card = addBtn.closest('.catalog-item') as HTMLElement;
  if (!card) return;

  const rawPayload = card.dataset.productPayload;
  if (!rawPayload) return;

  try {
    const product = JSON.parse(decodeURIComponent(rawPayload));
    
    // Tenta primeiro pelo Select (Mobile)
    const select = card.querySelector('[data-var-select]') as HTMLSelectElement | null;
    const activeVarBtn = card.querySelector('[data-var-btn].border-transparent') as HTMLElement | null;

    let selectedVariation = product.initialVariation?.name || 'Padrão';
    let finalPrice = product.price;
    let finalImage = product.image;

    if (select && select.offsetParent !== null) { // Visível no mobile
      const opt = select.options[select.selectedIndex];
      if (opt) {
        selectedVariation = opt.dataset.varName || selectedVariation;
        finalPrice = Number(opt.dataset.varPrice) || finalPrice;
        finalImage = opt.dataset.varImage || finalImage;
      }
    } else if (activeVarBtn) { // Visível no desktop
      selectedVariation = activeVarBtn.dataset.varName || selectedVariation;
      finalPrice = Number(activeVarBtn.dataset.varPrice) || finalPrice;
      finalImage = activeVarBtn.dataset.varImage || finalImage;
    }

    addToCart(product, selectedVariation, finalPrice, finalImage, 1);

    const btnSpan = addBtn.querySelector('span');
    if (btnSpan) {
      const originalText = btnSpan.textContent;
      btnSpan.textContent = 'Adicionado';
      setTimeout(() => { btnSpan.textContent = originalText; }, 700);
    }
  } catch (err) {
    console.error(err);
  }
});

    renderBook();
  }

  initCatalogBook();
  document.addEventListener('astro:page-load', initCatalogBook);
</script>