---
import type { SiteConfig } from '../../types';

interface Props {
  config: SiteConfig;
}

const { config } = Astro.props;
const currentYear = new Date().getFullYear();
---

<!-- 
  pb-32 sm:pb-24: Garante que o rodapé termine bem acima da barra flutuante
  relative z-20: Garante visibilidade e contraste limpo
-->
<footer id="catalog-footer" class="w-full pt-4 pb-16 sm:pb-24 text-[#8C847A] font-mono text-[9px] tracking-[0.22em] uppercase border-t border-[#EBE7DF]/80 relative z-20 transition-all duration-300">
  <div class="max-w-5xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
    
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[#1A1918]/60"></span>
      <p>© {currentYear} {config.name}. Edição Digital.</p>
    </div>

    <div class="text-[8px] tracking-[0.25em] text-[#A39B91]">
      Desenvolvido com primor por 
      <a 
        href="https://jakdigitaldesign.com" 
        target="_blank" 
        rel="noopener noreferrer"
        class="text-[#1A1918] hover:opacity-70 transition-opacity underline decoration-[#D5D0C6] underline-offset-2 ml-1"
      >
        Jak Digital Design
      </a>
    </div>

  </div>
</footer>