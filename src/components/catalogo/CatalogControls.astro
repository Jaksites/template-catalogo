---
// src/components/catalogo/CatalogControls.astro
---

<!-- Hotspot Lateral Esquerda (Voltar) -->
<button 
  id="dog-ear-prev" 
  type="button"
  aria-label="Página anterior"
  class="group absolute left-0 top-0 bottom-0 z-30 w-12 sm:w-16 flex items-center justify-start pl-2 cursor-pointer focus:outline-none transition-all duration-300 opacity-0 pointer-events-none hover:bg-black/5 active:bg-black/10 select-none"
>
  <div class="w-8 h-8 rounded-full bg-white/80 backdrop-blur-md shadow-md border border-[#E8E4DA] flex items-center justify-center text-[#2D2A26] transition-transform group-hover:-translate-x-0.5 group-active:scale-90">
    <svg class="w-4 h-4 stroke-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
    </svg>
  </div>
</button>

<!-- Hotspot Lateral Direita (Avançar) -->
<button 
  id="dog-ear-next" 
  type="button"
  aria-label="Próxima página"
  class="group absolute right-0 top-0 bottom-0 z-30 w-12 sm:w-16 flex items-center justify-end pr-2 cursor-pointer focus:outline-none transition-all duration-300 opacity-100 pointer-events-auto hover:bg-black/5 active:bg-black/10 select-none"
>
  <div class="w-8 h-8 rounded-full bg-white/80 backdrop-blur-md shadow-md border border-[#E8E4DA] flex items-center justify-center text-[#2D2A26] transition-transform group-hover:translate-x-0.5 group-active:scale-90">
    <svg class="w-4 h-4 stroke-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
    </svg>
  </div>
</button>