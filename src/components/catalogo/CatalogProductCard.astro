---
import type { Product } from '../../types';

interface Props {
  product: Product;
  index: number;
}

const { product, index } = Astro.props;
const safePayload = encodeURIComponent(JSON.stringify(product));
const initialVar = product.variations?.[0] || { name: 'Padrão', price: product.price, image: product.image };
const description = product.description || '';
const hasVariations = product.variations && product.variations.length > 1;
---

<article 
    class="catalog-item relative bg-[#FCFCFA] rounded-xl sm:rounded-2xl p-3 sm:p-6 border border-[#EBE8E1] shadow-xs flex flex-col justify-between h-full"
  data-index={index}
  data-category={product.category}
  data-product-payload={safePayload}
>
  <div class="flex flex-col min-h-0">
    
    <!-- Topo: Categoria + Badge -->
    <div class="flex items-center justify-between border-b border-[#ECE8E1] pb-2 mb-2.5 shrink-0">
      <span class="text-[9px] uppercase tracking-[0.2em] font-semibold text-[#8C827A] truncate">
        {product.category}
      </span>
      {product.badge && (
        <span 
          class="text-[8px] uppercase tracking-[0.15em] font-medium px-2 py-0.5 rounded-full shrink-0"
          style="background-color: var(--brand-accent, #E8DEC8); color: var(--brand-accent-text, #1F1E1D);"
        >
          {product.badge}
        </span>
      )}
    </div>

    <!-- Fotografia com Ícone de Informações / Detalhes Embutido -->
    <div class="relative w-full aspect-16/10 rounded-lg overflow-hidden bg-[#F0EEE6] mb-2.5 group shrink-0 border border-[#ECE8E1]">
      <img 
        data-item-image 
        src={initialVar.image || product.image} 
        alt={product.name}
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 filter contrast-[1.02]"
        loading="lazy"
      />

      <!-- Botão Flutuante de Informação/Receita (Abre Modal de Detalhes) -->
      {description && (
        <button
          type="button"
          data-open-desc-btn
          data-prod-name={product.name}
          data-prod-desc={description}
          data-prod-img={initialVar.image || product.image}
          data-prod-badge={product.badge || ''}
          data-prod-category={product.category || ''}
          title="Ver detalhes e composição"
          class="absolute top-2 right-2 w-7 h-7 rounded-full bg-[#181716]/75 hover:bg-[#181716] text-[#FAF8F5] backdrop-blur-md flex items-center justify-center transition-all active:scale-90 shadow-sm cursor-pointer z-10"
        >
          <svg class="w-3.5 h-3.5 stroke-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
          </svg>
        </button>
      )}
    </div>

    <!-- Título do Produto -->
    <h3 class="font-serif text-base sm:text-xl font-medium text-[#1A1918] tracking-tight leading-snug line-clamp-1 shrink-0">
      {product.name}
    </h3>

    <!-- Breve Resumo: 1 ou 2 linhas limpas que não quebram o layout -->
    {description && (
      <p class="mt-1 text-[11px] text-[#7A736E] font-light leading-snug line-clamp-2">
        {description}
      </p>
    )}
  </div>

  <!-- Bloco Inferior: Variação em Dropdown Único no Mobile / Pílulas no Desktop -->
  <div class="pt-2.5 border-t border-[#ECE8E1] shrink-0 mt-1">
    
    <!-- Controle de Variações: Pílula Compacta com Select no Mobile / Botões no Desktop -->
    {hasVariations ? (
      <div class="mb-3">
        
        <div class="sm:hidden relative">
          <label class="sr-only">Escolha a opção</label>
          <div class="relative flex items-center">
            <select
              data-var-select
              class="w-full appearance-none bg-[#F5F2EB] border border-[#DDD8CE] text-[#1A1918] text-[11px] font-medium py-2 pl-3 pr-8 rounded-lg cursor-pointer focus:outline-hidden focus:border-[#1A1918] transition-colors"
            >
              {product.variations!.map((v, vIdx) => (
                <option 
                  value={vIdx}
                  data-var-name={v.name}
                  data-var-price={v.price ?? product.price}
                  data-var-image={v.image || product.image}
                >
                  {v.name} — R$ {(v.price ?? product.price).toFixed(2).replace('.', ',')}
                </option>
              ))}
            </select>
            <!-- Seta minimalista do select -->
            <div class="pointer-events-none absolute right-2.5 text-[#7A7268]">
              <svg class="w-3.5 h-3.5 stroke-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </div>
          </div>
        </div>

        <!-- DESKTOP: Mantém as pílulas sofisticadas para cliques rápidos -->
        <div class="hidden sm:flex flex-wrap gap-1.5" data-variations-group>
          {product.variations!.map((v, vIdx) => (
            <button
              type="button"
              data-var-btn
              data-var-idx={vIdx}
              data-var-name={v.name}
              data-var-price={v.price ?? product.price}
              data-var-image={v.image || product.image}
              class={`px-2.5 py-1 text-[11px] font-medium tracking-wide rounded-md border transition-all cursor-pointer truncate max-w-full ${
                vIdx === 0 
                  ? 'border-transparent text-white shadow-xs' 
                  : 'bg-white text-[#524D48] border-[#DFDBD3] hover:border-[#8C827A]'
              }`}
              style={vIdx === 0 ? "background-color: var(--brand-dark, #1A1918);" : ""}
            >
              {v.name}
            </button>
          ))}
        </div>

      </div>
    ) : (
      
      <div class="h-1 sm:h-2"></div>
    )}

    <!-- Preço e Botão Adicionar -->
    <div class="flex items-center justify-between gap-3 pt-1">
      <div>
        <span class="block text-[8px] uppercase tracking-[0.2em] text-[#A39C94] font-medium font-mono leading-none">Preço</span>
        <span data-item-price class="text-base sm:text-xl font-serif font-semibold text-[#1A1918] tracking-tight mt-0.5 block">
          R$ {(initialVar.price ?? product.price).toFixed(2).replace('.', ',')}
        </span>
      </div>

      <button 
        type="button"
        data-btn-add-cart
        class="group inline-flex items-center gap-1.5 px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-xl text-[#FAF8F5] text-[10px] font-medium tracking-wider uppercase transition-all duration-300 active:scale-95 cursor-pointer shadow-xs hover:opacity-90 shrink-0"
        style="background-color: var(--brand-dark, #1A1918);"
      >
        <span>Adicionar</span>
        <svg class="w-3.5 h-3.5 stroke-2 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      </button>
    </div>

    <!-- Paginação da Revista -->
    <div class="mt-2 text-right">
      <span class="text-[9px] font-mono tracking-widest text-[#B8B2AA]">
        Nº {String(index + 1).padStart(2, '0')}
      </span>
    </div>

  </div>
</article>