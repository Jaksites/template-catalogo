---
// src/components/catalogo/DemoPresetSwitcher.astro
interface Props {
  currentPreset: string;
  presetsList: Array<{ slug: string; name: string }>;
}

const { currentPreset, presetsList } = Astro.props;
---

<nav aria-label="Seletor de Demonstrações" class="w-full bg-[#161514] text-[#FAF8F5] border-b border-[#2B2926] sticky top-0 z-40 shadow-md">
  <div class="max-w-6xl mx-auto px-4 py-2.5 flex items-center justify-between gap-4">
    
    <!-- Identificação do Modo Vitrine -->
    <div class="flex items-center gap-2 shrink-0">
      <span class="w-2 h-2 rounded-full bg-[#C5A880] animate-pulse"></span>
      <span class="text-[10px] font-mono tracking-[0.25em] uppercase text-[#B5AEA3] font-medium hidden sm:inline">
        Modo Demonstração
      </span>
    </div>

    <!-- Pílulas de Navegação com Rolagem Horizontal Suave -->
    <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
      {presetsList.map((item) => {
        const isActive = item.slug.toLowerCase() === currentPreset.toLowerCase();
        return (
          <a
            href={`?preset=${item.slug.toLowerCase()}`}
            class={`px-3 py-1.5 rounded-lg text-[11px] font-medium tracking-wider whitespace-nowrap transition-all duration-200 cursor-pointer ${
              isActive
                ? 'bg-[#FAF8F5] text-[#161514] shadow-xs'
                : 'text-[#9E978F] hover:text-[#FAF8F5] hover:bg-white/5'
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </div>

  </div>
</nav>

<style>
  /* Esconde barra de rolagem horizontal */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>