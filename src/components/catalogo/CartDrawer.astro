---
import { siteConfig } from '../../config/active';
import { checkStoreStatus } from '../../scripts/businessHours';
import type { SiteConfig } from '../../types';

interface Props {
  config?: SiteConfig;
}

const { config = siteConfig } = Astro.props;
const status = checkStoreStatus(config.businessHours);
---

<div id="cart-modal" class="fixed inset-0 z-50 invisible pointer-events-none transition-all duration-500 font-sans">
  <!-- Backdrop Suave com Filtro Difuso -->
  <div id="cart-backdrop" class="absolute inset-0 bg-[#141312]/40 backdrop-blur-md opacity-0 transition-opacity duration-500"></div>

  <!-- Gaveta Lateral (Drawer) em tom Alabaster com Borda Fina -->
  <div 
    id="cart-panel" 
    class="absolute right-0 top-0 bottom-0 w-full max-w-md bg-[#FAF9F5] shadow-[-20px_0_60px_rgba(20,15,10,0.15)] border-l border-[#EBE7DF] flex flex-col justify-between transform translate-x-full transition-transform duration-500 cubic-bezier(0.16, 1, 0.3, 1) z-10"
  >
    
    <!-- Cabeçalho Editorial -->
    <div class="px-6 py-5 border-b border-[#ECE7DF] flex items-center justify-between bg-white/60 backdrop-blur-xs">
      <div>
        <span class="text-[9px] uppercase tracking-[0.25em] font-mono text-[#8C857B] block mb-0.5">Sua Seleção</span>
        <div class="flex items-baseline gap-2">
          <h3 class="font-serif text-2xl font-normal text-[#1A1918] tracking-tight">Sacola de Pedidos</h3>
          <span id="cart-header-count" class="text-[11px] font-mono text-[#A39B91]">0 itens</span>
        </div>
      </div>

      <button 
        id="close-cart-btn" 
        class="group p-2 text-[#7A736A] hover:text-[#1A1918] transition-colors rounded-full cursor-pointer focus:outline-hidden" 
        aria-label="Fechar sacola"
      >
        <svg class="w-5 h-5 stroke-[1.5] transition-transform duration-300 group-hover:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Lista de Itens do Carrinho -->
    <div id="cart-items" class="p-6 grow overflow-y-auto flex flex-col gap-4 divide-y divide-[#ECE7DF]/70">
      <!-- Injetado dinamicamente via Javascript -->
    </div>

    <!-- Rodapé Editorial e Checkout -->
    <div class="p-6 border-t border-[#ECE7DF] bg-[#F4F1EA]/80 backdrop-blur-xs flex flex-col gap-4">
      
      <!-- Linhas de Valores -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-xs text-[#7A736A]">
          <span class="tracking-wide uppercase text-[10px] font-mono">Subtotal</span>
          <span id="cart-subtotal" class="font-mono text-sm text-[#38332E]">R$ 0,00</span>
        </div>

        <div class="flex items-baseline justify-between pt-2 border-t border-[#E5E0D5]">
          <span class="font-serif text-base text-[#1A1918]">Total Estimado</span>
          <span id="cart-total" class="font-serif text-2xl font-semibold text-[#1A1918]">R$ 0,00</span>
        </div>
      </div>

      <!-- Aviso refinado se a loja estiver FECHADA -->
      {!status.isOpen && (
        <div class="p-3.5 bg-[#EFECE4] border border-[#DDD7CA] rounded-xl flex items-start gap-3 text-xs text-[#59524A]">
          <svg class="w-4 h-4 text-[#8C8172] shrink-0 mt-0.5 stroke-[1.8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div>
            <strong class="font-mono text-[10px] uppercase tracking-wider block text-[#3A352F]">Catálogo em Demonstração</strong>
            <p class="text-[11px] mt-0.5 text-[#6B6358] leading-relaxed">{status.message}</p>
          </div>
        </div>
      )}

      <!-- Botão de Ação / Checkout -->
      <button 
        id="btn-checkout-modal" 
        disabled={!status.isOpen}
        data-store-open={status.isOpen ? 'true' : 'false'}
        class={`w-full py-4 px-5 text-xs font-medium tracking-[0.2em] uppercase rounded-xl flex items-center justify-center gap-2 transition-all duration-300 shadow-sm cursor-pointer active:scale-[0.99] ${
          status.isOpen 
            ? 'bg-[#1A1918] hover:bg-[#2C2926] text-[#FAF8F5] disabled:bg-[#D5D0C6] disabled:text-[#8C857B] disabled:cursor-not-allowed' 
            : 'bg-[#DCD8CF] text-[#8C857B] cursor-not-allowed border border-[#D0CBC0]'
        }`}
      >
        <span>{status.isOpen ? 'Prosseguir para Checkout' : 'Atendimento Pausado'}</span>
        {status.isOpen ? (
          <span class="font-serif text-sm">→</span>
        ) : (
          <svg class="w-3.5 h-3.5 stroke-[1.8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        )}
      </button>

      <p class="text-center text-[10px] text-[#A69E94] font-mono tracking-widest uppercase">
        Finalização direta via WhatsApp Oficial
      </p>
    </div>
  </div>
</div>

<style>
  .font-serif {
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
</style>

<script>
  import { getCart, updateQuantity, getCartTotals } from '../../scripts/cartStore';

  const modal = document.getElementById('cart-modal')!;
  const backdrop = document.getElementById('cart-backdrop')!;
  const panel = document.getElementById('cart-panel')!;
  const cartItemsContainer = document.getElementById('cart-items')!;
  const headerCountEl = document.getElementById('cart-header-count')!;
  const subtotalEl = document.getElementById('cart-subtotal')!;
  const totalEl = document.getElementById('cart-total')!;
  const btnCheckout = document.getElementById('btn-checkout-modal') as HTMLButtonElement;
  const isStoreOpen = btnCheckout.dataset.storeOpen === 'true';

  function toggle(open: boolean) {
    if (open) {
      modal.classList.remove('invisible', 'pointer-events-none');
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        backdrop.classList.add('opacity-100');
        panel.classList.remove('translate-x-full');
      }, 10);
      render();
    } else {
      backdrop.classList.remove('opacity-100');
      panel.classList.add('translate-x-full');
      document.body.style.overflow = '';
      setTimeout(() => {
        modal.classList.add('invisible', 'pointer-events-none');
      }, 500);
    }
  }

  function render() {
    const cart = getCart();
    const { totalCount, totalPrice } = getCartTotals();

    headerCountEl.textContent = `${totalCount} ${totalCount === 1 ? 'item' : 'itens'}`;
    subtotalEl.textContent = `R$ ${totalPrice.toFixed(2).replace('.', ',')}`;
    totalEl.textContent = `R$ ${totalPrice.toFixed(2).replace('.', ',')}`;

    if (cart.length === 0 || !isStoreOpen) {
      btnCheckout.disabled = true;
    } else {
      btnCheckout.disabled = false;
    }

    if (cart.length === 0) {
      cartItemsContainer.innerHTML = `
        <div class="flex flex-col items-center justify-center h-full text-center py-20 px-4">
          <div class="w-14 h-14 rounded-full border border-[#DFDBD1] flex items-center justify-center text-[#A69E94] mb-4">
            <svg class="w-6 h-6 stroke-[1.2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
          </div>
          <p class="font-serif text-lg text-[#1A1918]">Sua sacola está vazia</p>
          <p class="text-xs text-[#8C847B] font-light mt-1 max-w-[200px] leading-relaxed">
            Selecione criações exclusivas das páginas para compor seu pedido.
          </p>
          <button id="btn-empty-shop" class="mt-5 text-[11px] font-mono uppercase tracking-[0.2em] text-[#1A1918] border-b border-[#1A1918] pb-0.5 hover:opacity-70 transition-opacity cursor-pointer">
            Folhear Catálogo
          </button>
        </div>
      `;

      document.getElementById('btn-empty-shop')?.addEventListener('click', () => toggle(false));
    } else {
      cartItemsContainer.innerHTML = cart.map((item: any, index: number) => {
        const unitPrice = item.unitPrice ?? item.product.price;
        const itemImage = item.selectedImage || item.product.image;
        const itemTotal = unitPrice * item.quantity;

        return `
          <div class="pt-4 first:pt-0 flex items-center gap-3.5 group">
            <div class="w-16 h-16 rounded-lg overflow-hidden bg-[#ECE8DE] border border-[#E3DFD5] shrink-0">
              <img 
                src="${itemImage}" 
                alt="${item.product.name}" 
                class="w-full h-full object-cover filter contrast-[1.02]"
              >
            </div>
            
            <div class="grow min-w-0">
              <h4 class="font-serif text-base text-[#1A1918] truncate font-medium leading-snug">${item.product.name}</h4>
              <p class="text-[11px] text-[#787169] mt-0.5 truncate">
                Variação: <span class="font-medium text-[#2E2A27]">${item.selectedSize}</span>
              </p>
              <div class="flex items-baseline gap-2 mt-1">
                <span class="font-serif text-sm font-semibold text-[#1A1918]">R$ ${itemTotal.toFixed(2).replace('.', ',')}</span>
                ${item.quantity > 1 ? `<span class="text-[10px] font-mono text-[#999187]">(${item.quantity} × R$ ${unitPrice.toFixed(2).replace('.', ',')})</span>` : ''}
              </div>
            </div>

            <!-- Ajuste de Quantidade Elegante -->
            <div class="flex items-center border border-[#DFDBD1] bg-white rounded-lg p-0.5 shrink-0">
              <button 
                data-qty-change="${index}" 
                data-delta="-1" 
                class="w-6 h-6 flex items-center justify-center text-[#615A52] hover:text-[#1A1918] hover:bg-[#F5F2EB] rounded transition-colors text-xs cursor-pointer"
                aria-label="Diminuir"
              >
                ${item.quantity === 1 ? `
                  <svg class="w-3 h-3 stroke-[1.8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                ` : '−'}
              </button>
              <span class="text-xs font-mono font-medium w-5 text-center text-[#1A1918]">${item.quantity}</span>
              <button 
                data-qty-change="${index}" 
                data-delta="1" 
                class="w-6 h-6 flex items-center justify-center text-[#615A52] hover:text-[#1A1918] hover:bg-[#F5F2EB] rounded transition-colors text-xs cursor-pointer"
                aria-label="Aumentar"
              >
                +
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    // Ouvintes dos botões de quantidade
    document.querySelectorAll('[data-qty-change]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const idx = Number(target.dataset.qtyChange);
        const delta = Number(target.dataset.delta);
        updateQuantity(idx, delta);
        render();
      });
    });
  }

  // Event Listeners de Abertura / Fechamento
  document.getElementById('close-cart-btn')?.addEventListener('click', () => toggle(false));
  backdrop.addEventListener('click', () => toggle(false));
  window.addEventListener('cart:open', () => toggle(true));
  window.addEventListener('cart:updated', render);
  
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') toggle(false);
  });

  // Abertura do Modal de Checkout
  btnCheckout.addEventListener('click', () => {
    if (!isStoreOpen) return;
    toggle(false);
    window.dispatchEvent(new CustomEvent('checkout:open'));
  });
</script>