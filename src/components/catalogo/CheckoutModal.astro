---
interface Props {
  whatsappNumber: string;
}

const { whatsappNumber } = Astro.props;
---

<div 
  id="checkout-modal" 
  data-whatsapp={whatsappNumber}
  class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-6 font-sans"
>
  <!-- Backdrop Difuso e Acetinado -->
  <div id="checkout-backdrop" class="absolute inset-0 bg-[#121110]/50 backdrop-blur-md cursor-pointer transition-opacity"></div>

  <!-- Janela Modal com Proporção de Livro/Convite -->
  <div class="relative bg-[#FAF9F5] w-full max-w-lg rounded-2xl shadow-[0_25px_60px_rgba(15,12,10,0.35)] overflow-hidden flex flex-col max-h-[92vh] z-10 border border-[#E8E4DA]">
    
    <!-- Header Editorial: Preto Carvão com Fio Metálico -->
    <div class="relative p-5 sm:p-6 bg-[#181716] text-[#FAF8F5] flex items-center justify-between border-b border-[#292623]">
      <div class="absolute top-0 left-8 right-8 h-px bg-linear-to-r from-transparent via-[#C5A880]/30 to-transparent"></div>
      
      <div>
        <span class="text-[9px] font-mono uppercase tracking-[0.25em] text-[#A69E94] block mb-1">Finalização</span>
        <h3 class="font-serif text-xl sm:text-2xl font-normal tracking-tight text-[#FAF8F5] leading-none">Dados do Pedido</h3>
      </div>

      <button 
        id="close-checkout-btn" 
        type="button" 
        class="group p-2 text-[#8C847A] hover:text-white rounded-full transition-colors cursor-pointer"
        aria-label="Fechar"
      >
        <svg class="w-5 h-5 stroke-[1.5] transition-transform duration-300 group-hover:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Resumo de Conferência -->
    <div class="px-6 py-3 bg-[#F2EFE8] border-b border-[#E5E0D5] flex items-center justify-between text-xs text-[#6B635A]">
      <span class="font-mono text-[11px] tracking-wide">
        Seleção: <strong id="checkout-items-count" class="text-[#1A1918] font-semibold">0 itens</strong>
      </span>
      <span class="font-mono text-[11px] tracking-wide">
        Total: <strong id="checkout-total-value" class="font-serif font-semibold text-base text-[#1A1918]">R$ 0,00</strong>
      </span>
    </div>

    <!-- Formulário com Estilo Minimalista -->
    <form id="checkout-form" class="p-6 overflow-y-auto flex flex-col gap-4 text-xs">
      
      <!-- Modalidade de Recebimento -->
      <div>
        <label class="block font-mono text-[10px] uppercase tracking-[0.2em] text-[#7A7268] mb-2">Modalidade</label>
        <div class="grid grid-cols-2 gap-2.5">
          <label class="delivery-option flex items-center justify-center gap-2 p-3 rounded-xl border border-[#1A1918] bg-[#1A1918] text-[#FAF8F5] font-medium tracking-wide text-xs cursor-pointer transition-all">
            <input type="radio" name="order-type" value="Entrega" checked class="hidden" />
            <svg class="w-3.5 h-3.5 stroke-[1.8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25V3.75a1.125 1.125 0 00-1.125-1.125h-9a1.125 1.125 0 00-1.125 1.125v10.5h16.5" />
            </svg>
            <span>Entrega </span>
          </label>
          <label class="delivery-option flex items-center justify-center gap-2 p-3 rounded-xl border border-[#DFDBD1] bg-white text-[#635C54] font-medium tracking-wide text-xs cursor-pointer transition-all hover:border-[#8C847A]">
            <input type="radio" name="order-type" value="Retirada no Local" class="hidden" />
            <svg class="w-3.5 h-3.5 stroke-[1.8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.25A2.25 2.25 0 010 18.75V10.5m16.5 10.5h5.25A2.25 2.25 0 0024 18.75V10.5M9 7.5l3-3 3 3M3 10.5h18" />
            </svg>
            <span>Retirada </span>
          </label>
        </div>
      </div>

      <!-- Dados de Contato -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block font-mono text-[10px] uppercase tracking-[0.2em] text-[#7A7268] mb-1" for="cust-name">Nome Completo *</label>
          <input 
            type="text" 
            id="cust-name" 
            required 
            placeholder="Ex: Cecília Ramos" 
            class="w-full px-3.5 py-2.5 rounded-lg border border-[#DDD8CE] bg-white text-[#1A1918] placeholder-[#B5AEA4] focus:border-[#1A1918] focus:ring-1 focus:ring-[#1A1918] outline-hidden transition-all text-xs" 
          />
        </div>

        <div>
          <label class="block font-mono text-[10px] uppercase tracking-[0.2em] text-[#7A7268] mb-1" for="cust-phone">WhatsApp de Contato *</label>
          <input 
            type="tel" 
            id="cust-phone" 
            required 
            maxlength="15"
            placeholder="(11) 99999-9999" 
            class="w-full px-3.5 py-2.5 rounded-lg border border-[#DDD8CE] bg-white text-[#1A1918] placeholder-[#B5AEA4] focus:border-[#1A1918] focus:ring-1 focus:ring-[#1A1918] outline-hidden transition-all text-xs" 
          />
        </div>
      </div>

      <!-- Endereço para Entrega -->
      <div id="address-fields" class="flex flex-col gap-3 transition-all">
        <div>
          <label class="block font-mono text-[10px] uppercase tracking-[0.2em] text-[#7A7268] mb-1" for="cust-address">Endereço Completo *</label>
          <input 
            type="text" 
            id="cust-address" 
            required 
            placeholder="Rua, número, apto/bloco e bairro" 
            class="w-full px-3.5 py-2.5 rounded-lg border border-[#DDD8CE] bg-white text-[#1A1918] placeholder-[#B5AEA4] focus:border-[#1A1918] focus:ring-1 focus:ring-[#1A1918] outline-hidden transition-all text-xs" 
          />
        </div>

        <div class="grid grid-cols-3 gap-2.5">
          <div class="col-span-2">
            <label class="block font-mono text-[10px] uppercase tracking-[0.2em] text-[#7A7268] mb-1" for="cust-city">Cidade *</label>
            <input 
              type="text" 
              id="cust-city" 
              required 
              placeholder="Sua cidade" 
              class="w-full px-3.5 py-2.5 rounded-lg border border-[#DDD8CE] bg-white text-[#1A1918] placeholder-[#B5AEA4] focus:border-[#1A1918] focus:ring-1 focus:ring-[#1A1918] outline-hidden transition-all text-xs" 
            />
          </div>
          <div>
            <label class="block font-mono text-[10px] uppercase tracking-[0.2em] text-[#7A7268] mb-1" for="cust-uf">UF *</label>
            <input 
              type="text" 
              id="cust-uf" 
              required 
              maxlength="2" 
              placeholder="SP" 
              class="uppercase w-full px-3.5 py-2.5 rounded-lg border border-[#DDD8CE] bg-white text-[#1A1918] placeholder-[#B5AEA4] focus:border-[#1A1918] focus:ring-1 focus:ring-[#1A1918] outline-hidden transition-all text-xs text-center" 
            />
          </div>
        </div>
      </div>

      <!-- Forma de Pagamento -->
      <div>
        <label class="block font-mono text-[10px] uppercase tracking-[0.2em] text-[#7A7268] mb-2">Forma de Pagamento Pretendida *</label>
        <div class="grid grid-cols-3 gap-2">
          <label class="payment-card flex flex-col items-center justify-center p-2.5 rounded-xl border border-[#1A1918] bg-[#1A1918] text-[#FAF8F5] cursor-pointer text-center transition-all">
            <input type="radio" name="payment-method" value="Pix (Imediato)" checked class="hidden" />
            <span class="font-mono text-xs font-semibold tracking-wider">PIX</span>
           
          </label>

          <label class="payment-card flex flex-col items-center justify-center p-2.5 rounded-xl border border-[#DFDBD1] bg-white text-[#575048] cursor-pointer text-center transition-all hover:border-[#8C847A]">
            <input type="radio" name="payment-method" value="Cartão de Crédito" class="hidden" />
            <span class="font-mono text-xs font-medium tracking-wider">CARTÃO</span>
            
          </label>

          <label class="payment-card flex flex-col items-center justify-center p-2.5 rounded-xl border border-[#DFDBD1] bg-white text-[#575048] cursor-pointer text-center transition-all hover:border-[#8C847A]">
            <input type="radio" name="payment-method" value="Dinheiro" class="hidden" />
            <span class="font-mono text-xs font-medium tracking-wider">OUTROS</span>
            
          </label>
        </div>
      </div>

      <!-- Observações -->
      <div>
        <label class="block font-mono text-[10px] uppercase tracking-[0.2em] text-[#7A7268] mb-1" for="cust-obs">Observações Especiais (Opcional)</label>
        <textarea 
          id="cust-obs" 
          rows="2" 
          placeholder="Ex: Instruções de entrega, preferências ou embalagem para presente..." 
          class="w-full px-3.5 py-2.5 rounded-lg border border-[#DDD8CE] bg-white text-[#1A1918] placeholder-[#B5AEA4] focus:border-[#1A1918] focus:ring-1 focus:ring-[#1A1918] outline-hidden transition-all text-xs resize-none"
        ></textarea>
      </div>

      <!-- Botão de Confirmação e Envio -->
      <button 
        type="submit" 
        class="w-full mt-2 py-3.5 bg-[#1A1918] hover:bg-[#2C2926] text-[#FAF8F5] text-xs font-medium tracking-[0.2em] uppercase rounded-xl flex items-center justify-center gap-2 transition-all duration-300 shadow-sm active:scale-[0.99] cursor-pointer"
      >
        <span>Pedir via WhatsApp</span>
        <span class="font-serif text-sm">→</span>
      </button>
    </form>

  </div>
</div>

<style>
  .font-serif {
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
</style>

<script>
  import { getCart, getCartTotals } from '../../scripts/cartStore';

  const modal = document.getElementById('checkout-modal');
  const backdrop = document.getElementById('checkout-backdrop');
  const closeBtn = document.getElementById('close-checkout-btn');
  const form = document.getElementById('checkout-form') as HTMLFormElement;
  const phoneInput = document.getElementById('cust-phone') as HTMLInputElement;
  const addressContainer = document.getElementById('address-fields') as HTMLElement;
  const addressInputs = addressContainer?.querySelectorAll('input');

  function openCheckout() {
    if (!modal) return;
    const { totalCount, totalPrice } = getCartTotals();

    const countEl = document.getElementById('checkout-items-count');
    const totalEl = document.getElementById('checkout-total-value');
    if (countEl) countEl.textContent = `${totalCount} ${totalCount === 1 ? 'item' : 'itens'}`;
    if (totalEl) totalEl.textContent = `R$ ${totalPrice.toFixed(2).replace('.', ',')}`;

    modal.classList.remove('hidden');
    modal.classList.add('flex');

    setTimeout(() => {
      (document.getElementById('cust-name') as HTMLInputElement)?.focus();
    }, 120);
  }

  function closeCheckout() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  window.addEventListener('checkout:open', openCheckout);
  closeBtn?.addEventListener('click', closeCheckout);
  backdrop?.addEventListener('click', closeCheckout);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeCheckout();
    }
  });

  // Alternância Entrega vs Retirada
  document.querySelectorAll('input[name="order-type"]').forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      const options = document.querySelectorAll('.delivery-option');

      options.forEach(opt => {
        opt.className = 'delivery-option flex items-center justify-center gap-2 p-3 rounded-xl border border-[#DFDBD1] bg-white text-[#635C54] font-medium tracking-wide text-xs cursor-pointer transition-all hover:border-[#8C847A]';
      });

      target.parentElement!.className = 'delivery-option flex items-center justify-center gap-2 p-3 rounded-xl border border-[#1A1918] bg-[#1A1918] text-[#FAF8F5] font-medium tracking-wide text-xs cursor-pointer transition-all';

      if (target.value === 'Retirada no Local') {
        addressContainer.classList.add('hidden');
        addressInputs.forEach(i => i.removeAttribute('required'));
      } else {
        addressContainer.classList.remove('hidden');
        addressInputs.forEach(i => i.setAttribute('required', 'true'));
      }
    });
  });

  // Alternância Estilizada dos Cards de Pagamento
  document.querySelectorAll('input[name="payment-method"]').forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      const cards = document.querySelectorAll('.payment-card');

      cards.forEach(card => {
        card.className = 'payment-card flex flex-col items-center justify-center p-2.5 rounded-xl border border-[#DFDBD1] bg-white text-[#575048] cursor-pointer text-center transition-all hover:border-[#8C847A]';
        const sub = card.querySelector('span:last-child');
        if (sub) sub.className = 'text-[9px] text-[#9E978E] mt-0.5';
      });

      target.parentElement!.className = 'payment-card flex flex-col items-center justify-center p-2.5 rounded-xl border border-[#1A1918] bg-[#1A1918] text-[#FAF8F5] cursor-pointer text-center transition-all';
      const activeSub = target.parentElement!.querySelector('span:last-child');
      if (activeSub) activeSub.className = 'text-[9px] text-[#A69E94] mt-0.5';
    });
  });

  // Máscara Telefônica
  phoneInput?.addEventListener('input', (e) => {
    let value = (e.target as HTMLInputElement).value.replace(/\D/g, '');
    if (value.length > 11) value = value.slice(0, 11);

    if (value.length > 6) {
      value = `(${value.slice(0, 2)}) ${value.slice(2, 7)}-${value.slice(7)}`;
    } else if (value.length > 2) {
      value = `(${value.slice(0, 2)}) ${value.slice(2)}`;
    } else if (value.length > 0) {
      value = `(${value}`;
    }
    (e.target as HTMLInputElement).value = value;
  });

  // Mensagem Formatada Estilo Concierge
  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const whatsappNumber = modal?.dataset.whatsapp || '';
    const cart = getCart();
    const { totalPrice } = getCartTotals();

    const orderType = (document.querySelector('input[name="order-type"]:checked') as HTMLInputElement).value;
    const payment = (document.querySelector('input[name="payment-method"]:checked') as HTMLInputElement).value;
    const name = (document.getElementById('cust-name') as HTMLInputElement).value.trim();
    const phone = phoneInput.value.trim();
    const obs = (document.getElementById('cust-obs') as HTMLTextAreaElement).value.trim();

    let msg = `✦ *NOVA SOLICITAÇÃO DE PEDIDO* ✦\n`;
    msg += `— Modalidade: *${orderType.toUpperCase()}*\n`;
    msg += `═══════════════════════════════\n\n`;

    msg += `👤 *DADOS DO CLIENTE*\n`;
    msg += `• Nome: ${name}\n`;
    msg += `• Contato: ${phone}\n`;

    if (orderType === 'Entrega') {
      const address = (document.getElementById('cust-address') as HTMLInputElement).value.trim();
      const city = (document.getElementById('cust-city') as HTMLInputElement).value.trim();
      const uf = (document.getElementById('cust-uf') as HTMLInputElement).value.trim().toUpperCase();
      msg += `• Destino: ${address}\n`;
      msg += `• Cidade: ${city} - ${uf}\n`;
    }

    msg += `\n🛍️ *ITENS SELECIONADOS*\n`;
    cart.forEach((item, i) => {
      const sub = (item.product.price * item.quantity).toFixed(2).replace('.', ',');
      msg += `${String(i + 1).padStart(2, '0')}. *${item.product.name}*\n`;
      msg += `    ${item.selectedSize}  |  ${item.quantity} un  |  R$ ${sub}\n`;
    });

    msg += `\n───────────────────────────────\n`;
    msg += `• *TOTAL DO PEDIDO:* R$ ${totalPrice.toFixed(2).replace('.', ',')}\n`;
    msg += `• *Pagamento Pretendido:* ${payment}\n`;

    if (obs) {
      msg += `\n📝 *OBSERVAÇÕES:*\n${obs}\n`;
    }

    msg += `═══════════════════════════════\n`;
    msg += `Aguardando confirmação e atendimento.`;

    const cleanNumber = whatsappNumber.replace(/\D/g, '');
    const url = `https://wa.me/${cleanNumber}?text=${encodeURIComponent(msg)}`;
    window.open(url, '_blank');
  });
</script>